rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /tasks/{taskId} {
      allow read: if true;
      allow write: if isValidId(taskId);
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isValidId(userId);
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isValidId(projectId);
    }

    match /columns/{columnId} {
      allow read: if true;
      allow write: if isValidId(columnId);
    }

    match /messages/{messageId} {
      allow read: if true;
      allow write: if isValidId(messageId);
    }

    match /test/{docId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
